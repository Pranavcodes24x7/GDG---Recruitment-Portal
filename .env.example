# ==========================================
# 1. LOCAL EMULATOR CONFIGURATION (Optional)
# ==========================================
# Uncomment to use local Firestore emulator instead of production Cloud Firestore:
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# For a visual/auth-only local preview with no Firebase credentials:
# AUTH_LOCAL_DEMO="true"
# NEXT_PUBLIC_LOCAL_DEMO="true"

# ==========================================
# 2. FIREBASE FIRESTORE CONFIGURATION
# ==========================================
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional alternative to the credentials above:
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# ==========================================
# 3. FIREBASE CLIENT CONFIGURATION
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# ==========================================
# 4. BETTER-AUTH & SESSION CONFIGURATION
# ==========================================
BETTER_AUTH_SECRET="use-a-long-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"  # Set to production URL when deployed

# Optional: set an ISO 8601 timestamp to close submissions server-side.
# RECRUITMENT_DEADLINE="2026-09-30T23:59:59+05:30"

# ==========================================
# 5. GOOGLE OAUTH PROVIDER (VIT Email Auth)
# ==========================================
GOOGLE_CLIENT_ID="xxxx-xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxx"
# Set this to true only after the two Google OAuth values above are configured.
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED="false"

# ==========================================
# 6. NODEMAILER EMAIL BROADCAST (Optional)
# ==========================================
EMAIL_USERNAME="your-email@gmail.com"
EMAIL_PASSWORD="your-gmail-app-password"
